{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openGym",
  "version": "1.4.1",
  "identifier": "com.robertbuilt.opengym",
  "build": {
    "frontendDist": "../../frontend/dist-desktop",
    "beforeBuildCommand": "node build-frontend.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "openGym",
        "width": 1200,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../../catalogue/media/still/": "exercise-media/still/",
      "../../catalogue/media/clip/": "exercise-media/clip/",
      "../../catalogue/media/NOTICE.md": "exercise-media/NOTICE.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
